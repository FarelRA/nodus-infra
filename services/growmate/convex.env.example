# Reference only: these values belong to the GrowMate Convex deployment, not
# to a compose env_file. Apply them after a fresh start (from the app repo):
#
#   cd ~/projects/apps/growmate
#   bunx convex env set RUSTFS_ENDPOINT http://rustfs:9000
#   bunx convex env set RUSTFS_ACCESS_KEY <value>
#   bunx convex env set RUSTFS_SECRET_KEY <value>
#   bunx convex env set RUSTFS_BUCKET_IMAGE images
#
# Use the values printed by deploy/setup-growmate.sh.
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY={{RUSTFS_ACCESS_KEY}}
RUSTFS_SECRET_KEY={{RUSTFS_SECRET_KEY}}
RUSTFS_BUCKET_IMAGE=images
