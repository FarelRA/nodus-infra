# GrowMate app runtime env. deploy/setup-growmate.sh generates the secrets.
NUXT_PUBLIC_RUSTFS_BASE_URL=https://storage.growmate.bond
NUXT_PUBLIC_RUSTFS_BUCKET_IMAGE=images
NUXT_PUBLIC_CONVEX_URL=https://convex.growmate.bond
CONVEX_SITE_URL=https://convex.growmate.bond

# Must match data/rustfs/.env.
RUSTFS_ACCESS_KEY={{RUSTFS_ACCESS_KEY}}
RUSTFS_SECRET_KEY={{RUSTFS_SECRET_KEY}}
RUSTFS_BUCKET_IMAGE=images

# Device fleet API plus the one-link demo login
# (https://growmate.bond/demo/<token>).
DEVICE_API_KEY={{DEVICE_API_KEY}}
DEMO_ACCESS_TOKEN={{DEMO_ACCESS_TOKEN}}
DEMO_EMAIL=demo@growmate.bond
DEMO_PASSWORD={{DEMO_PASSWORD}}
