# Convex deployment environment for KalaNidhi functions.
# deploy/setup-convex.sh renders this into data/kalanidhi/convex-functions.env
# (600) and the --post output reads it, so the secrets never appear on screen.
# Apply with: npx convex env set <KEY> "$(cat ...)" from the app repo.
BETTER_AUTH_SECRET={{BETTER_AUTH_SECRET}}
SITE_URL=https://kalanidhi.site
PAYMENTS_INTERNAL_KEY={{PAYMENTS_INTERNAL_KEY}}
