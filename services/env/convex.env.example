# KalaNidhi self-hosted Convex backend.
# deploy/setup-convex.sh renders this into data/kalanidhi/convex.env (600).
# Never commit the rendered file: it contains INSTANCE_SECRET.
INSTANCE_NAME=kalanidhi
INSTANCE_SECRET={{CONVEX_INSTANCE_SECRET}}

# Public origins as seen by browsers and by the Convex CLI. Changing these
# after the first deploy invalidates URLs baked into functions, so keep them.
CONVEX_CLOUD_ORIGIN=https://convex.kalanidhi.site
CONVEX_SITE_ORIGIN=https://convex-site.kalanidhi.site

# Self-hosted hygiene: no usage beacon, no Prometheus endpoint, and trust the
# proxy headers Traefik adds (TLS terminates at Traefik).
DISABLE_BEACON=true
DISABLE_METRICS_ENDPOINT=true
TRUST_ALL_PROXY_HEADERS=true
