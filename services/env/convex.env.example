# GrowMate's self-hosted Convex backend.
# deploy/setup-convex.sh generates the secrets; origins must match Traefik.
CONVEX_CLOUD_ORIGIN=https://convex.growmate.bond
CONVEX_SITE_ORIGIN=https://convex.growmate.bond

# Stable instance identity: never change this after the first start.
INSTANCE_NAME=growmate
INSTANCE_SECRET={{CONVEX_INSTANCE_SECRET}}

# Seed/admin account used by GrowMate's bootstrap (not read by the backend).
ADMIN_EMAIL=admin@growmate.bond
ADMIN_PASSWORD={{CONVEX_ADMIN_PASSWORD}}

# Object storage used by GrowMate functions; must match data/rustfs/.env.
RUSTFS_ACCESS_KEY={{RUSTFS_ACCESS_KEY}}
RUSTFS_SECRET_KEY={{RUSTFS_SECRET_KEY}}
RUSTFS_BUCKET_IMAGE=images
