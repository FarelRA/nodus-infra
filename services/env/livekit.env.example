# LiveKit server credentials for KalaNidhi.
# deploy/setup-livekit.sh renders this into data/kalanidhi/livekit.env (600)
# and then renders data/kalanidhi/livekit.yaml from it. Never commit either.
LIVEKIT_API_KEY={{LIVEKIT_API_KEY}}
LIVEKIT_API_SECRET={{LIVEKIT_API_SECRET}}

# Same keypair in the `key: secret` form LiveKit's YAML parser expects.
LIVEKIT_KEYS={{LIVEKIT_API_KEY}}: {{LIVEKIT_API_SECRET}}
