# KalaNidhi payments gateway (FarelRA/kalanidhi-payments) environment.
# deploy/setup-payments.sh renders this into data/kalanidhi/payments.env (600).
# Never commit the rendered file: it holds the internal key, webhook secret, and
# session vault passphrase.
#
# GOPAY_MERCHANT_ID and GOPAY_STATIC_QRIS are intentionally empty: fill them
# from the GoBiz dashboard before starting the gateway. Startup validates the
# QRIS checksum and refuses to run with a missing or placeholder payload.

NODE_ENV=production
# The container listens on all interfaces but is reachable only over the
# private compose network (no published port, no Traefik route).
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# SQLite file. Parent directories are created on boot; the bind mount keeps it
# under data/kalanidhi/payments-data.
STORE_PATH=/var/lib/kalanidhi/payments.sqlite

# 32 random bytes. Back it up separately from the SQLite volume: losing it means
# re-authenticating the GoPay session with OTP.
SESSION_VAULT_PASSPHRASE={{SESSION_VAULT_PASSPHRASE}}

# --- GoPay / GoBiz (leave empty until the merchant account is configured) ----
GOPAY_MERCHANT_ID=
# The merchant outlet's static QRIS payload (the long 000201... EMV string from
# the GoBiz dashboard). Do not use the placeholder from the gateway repo's
# .env.example; it is deliberately invalid.
GOPAY_STATIC_QRIS=

# --- Private API authentication ---------------------------------------------
# Sent as `x-internal-key`; never in a query string. Shared with the app env as
# PAYMENTS_INTERNAL_KEY and with data/kalanidhi/convex-functions.env.
INTERNAL_API_KEY={{INTERNAL_API_KEY}}

# --- Webhooks (gateway -> KalaNidhi) ----------------------------------------
WEBHOOK_URL=https://kalanidhi.site/api/payments/webhook
# Shared with the app env as PAYMENTS_WEBHOOK_SECRET.
WEBHOOK_SECRET={{WEBHOOK_SECRET}}

# Production-safe defaults: HTTPS only, no private/reserved destinations.
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BASE_DELAY_MS=1000
WEBHOOK_MAX_DELAY_MS=60000

# --- Reconciliation ---------------------------------------------------------
RECONCILE_INTERVAL_MS=15000
RECONCILE_JITTER_RATIO=0.2
CLOCK_SKEW_MS=60000
DEFAULT_EXPIRY_SECONDS=600
MAX_UNIQUE_OFFSET=999
