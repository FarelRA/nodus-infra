# Minecraft server runtime env. deploy/setup-minecraft.sh generates data/minecraft/.env.
# Java join: mc.farel.is-a.dev:25565 — Bedrock join: mc.farel.is-a.dev:19132
HEAP_GB={{HEAP_GB}}
TZ=Asia/Jakarta
# Bedrock join hostname — must be DNS-only (grey-cloud) A or CNAME to this box.
# Players join with this, the TLS cert is issued for it (Traefik ACME), and
# Geyser advertises it for NetherNet signaling.
MCSERVER_DOMAIN={{MCSERVER_DOMAIN}}
