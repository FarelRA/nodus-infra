# Reference only: these values belong to the Fabula Convex deployment, not to
# a compose env_file. Set them with `bunx convex env set` (or the dashboard)
# after deploy/setup-fabula.sh has created the instance secret and admin key.
#
#   bunx convex env set SITE_URL https://fabula.farel.at.eu.org
#   bunx convex env set JWT_PRIVATE_KEY --from-file <data>/fabula/auth/private.pem
#   bunx convex env set JWKS --from-file <data>/fabula/auth/jwks.json
#   bunx convex env set OPENAI_API_KEY <operator key>
#   bunx convex env set OPENAI_BASE_URL <operator endpoint>
#
# Model tiers and the image model are optional; unset values use app defaults.
SITE_URL=https://fabula.farel.at.eu.org
OPENAI_API_KEY=
OPENAI_BASE_URL=
FABULA_MODEL_SPOTLIGHT=
FABULA_MODEL_STANDARD=
FABULA_MODEL_CHEAP=
FABULA_IMAGE_MODEL=
